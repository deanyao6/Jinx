# Copy to .env and fill in. Only EXPO_PUBLIC_* values ship in the bundle; they are public by design.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_INBOUND_EMAIL_DOMAIN=in.example.com
# Crash reporting (optional). Leave empty to disable Sentry entirely. Only the user id is sent.
EXPO_PUBLIC_SENTRY_DSN=
# Source map uploads at build time (EAS): set SENTRY_ORG, SENTRY_PROJECT and SENTRY_AUTH_TOKEN as
# EAS secrets; the @sentry/react-native config plugin in app.json reads them.
