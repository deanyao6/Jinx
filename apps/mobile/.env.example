# Copy to .env and fill in. Only EXPO_PUBLIC_* values ship in the bundle; they are public by design.
#
# THIS FILE IS FOR LOCAL DEVELOPMENT ONLY. `.env` is gitignored, so EAS never uploads it and an
# EAS build sees none of these. The same values have to exist as EAS environment variables on the
# build profile's environment:
#
#   cd apps/mobile
#   eas env:create production --name EXPO_PUBLIC_SUPABASE_URL --value https://<ref>.supabase.co \
#     --visibility plaintext --type string
#   eas env:list production
#
# A build made without them installs and then crashes on launch; assertEnv() says which case it is.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The forwarding address UI is hidden while this is the example.com placeholder, and appears by
# itself once it names a real domain (src/lib/env.ts, forwardingEnabled).
EXPO_PUBLIC_INBOUND_EMAIL_DOMAIN=in.example.com
# "Continue with email" on the welcome screen. Always shown in development (codes land in Mailpit).
# In a release build it stays hidden until this is 1, which needs Resend and a domain first:
# without a sender the code never arrives and the user is stuck.
EXPO_PUBLIC_EMAIL_SIGN_IN=
# Crash reporting (optional). Leave empty to disable Sentry entirely. Only the user id is sent.
EXPO_PUBLIC_SENTRY_DSN=
# Source map uploads at build time (EAS): set SENTRY_ORG, SENTRY_PROJECT and SENTRY_AUTH_TOKEN as
# EAS secrets; the @sentry/react-native config plugin in app.json reads them.
# Demo mode (SPEC.md 8.9). Off by default: the app shows the signed-in user's own data.
# Set to 1 only for the visual parity harness and the reference screenshots, which need the
# fixture account the design was drawn from (Dean Yao, 31-17, the stamps, the storylines).
EXPO_PUBLIC_DEMO=

# Enable after applying the search v2 migrations to this backend.
EXPO_PUBLIC_SEARCH_V2=0
