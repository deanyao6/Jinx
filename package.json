{
  "name": "jinx",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/mobile",
    "packages/core",
    "ingest"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "bash scripts/ios-sim.sh",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "functions:test": "npm run functions:sync && cd supabase/functions && deno test --allow-all .",
    "functions:check": "npm run functions:sync && cd supabase/functions && deno check */index.ts",
    "functions:sync": "bash scripts/sync-core-to-functions.sh",
    "functions:serve": "npm run functions:sync && supabase functions serve --env-file supabase/functions/.env.local",
    "functions:deploy": "npm run functions:sync && supabase functions deploy",
    "db:types": "supabase gen types typescript --local > apps/mobile/src/lib/database.types.ts",
    "parity": "node scripts/parity/run.mjs",
    "parity:ref": "node scripts/parity/capture-reference.mjs",
    "parity:app": "node scripts/parity/capture-app.mjs",
    "parity:diff": "node scripts/parity/diff.mjs",
    "parity:inset": "node scripts/parity/measure-inset.mjs",
    "parity:selftest": "node scripts/parity/selftest.mjs",
    "build:icons": "node scripts/design/build-icons.mjs",
    "build:shapes": "node scripts/design/build-shapes.mjs",
    "build:design": "npm run build:icons && npm run build:shapes",
    "fonts": "python3 scripts/fonts/build-archivo.py",
    "fonts:check": "python3 scripts/fonts/build-archivo.py --check",
    "seed:colors:check": "python3 seed/scripts/check_team_colors.py",
    "parity:drift": "node scripts/parity/drift.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=22"
  }
}
