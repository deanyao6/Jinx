{
  "name": "appname-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/mobile",
    "packages/core",
    "ingest"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "npm run run:ios --workspace apps/mobile",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "functions:test": "npm run functions:sync && cd supabase/functions && deno test --allow-all .",
    "functions:check": "npm run functions:sync && cd supabase/functions && deno check */index.ts",
    "functions:sync": "bash scripts/sync-core-to-functions.sh",
    "functions:serve": "npm run functions:sync && supabase functions serve --env-file supabase/functions/.env.local",
    "functions:deploy": "npm run functions:sync && supabase functions deploy",
    "db:types": "supabase gen types typescript --local > apps/mobile/src/lib/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "node": ">=22"
  }
}
